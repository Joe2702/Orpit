<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared by all five analytics widgets. The name each one shows in the picker
  comes from its receiver's android:label in the manifest, so a single provider
  description serves them all.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="150dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_stats"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_stats_description" />
