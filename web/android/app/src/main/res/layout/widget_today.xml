<?xml version="1.0" encoding="utf-8"?>
<!-- Today: the day at a glance. Today's habits as a ring, with steps, last
     night and this month's spending beside it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_card" android:padding="@dimen/w_pad">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/w_today" android:textColor="@color/w_text" android:textSize="15sp"
                android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/w_text3" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_weight="0.8" android:layout_height="match_parent">
                <ImageView android:id="@+id/w_ring" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitCenter" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/w_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/w_text" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                    <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/w_text3" android:textSize="11sp" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1.6" android:layout_height="match_parent"
                android:layout_marginStart="16dp" android:orientation="vertical">
            <LinearLayout android:id="@+id/w_steps" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_w_steps" android:importantForAccessibility="no" />
                <TextView android:id="@+id/w_steps_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:text="@string/w_steps" android:textColor="@color/w_text2" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/w_steps_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:textColor="@color/w_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_sleep" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_w_sleep" android:importantForAccessibility="no" />
                <TextView android:id="@+id/w_sleep_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:text="@string/w_sleep" android:textColor="@color/w_text2" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/w_sleep_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:textColor="@color/w_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_money" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_w_money" android:importantForAccessibility="no" />
                <TextView android:id="@+id/w_money_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:text="@string/w_money" android:textColor="@color/w_text2" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/w_money_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:textColor="@color/w_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
