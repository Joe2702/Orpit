<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- orbit:// URLs, used by the home-screen shortcuts below to open
                 straight into a logging sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="orbit" />
            </intent-filter>

            <!-- Long-press the app icon: Workout / Sleep / Expense. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- Home-screen widget: today's progress plus one-tap logging. -->
        <receiver
            android:name=".OrbitWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_orbit_info" />
        </receiver>

        <!-- Analytics widgets. One provider each, so every module is its own
             entry in the widget picker and the user can place any combination
             without a configuration screen. They share a layout and a provider
             description; only the picker label differs. -->
        <receiver
            android:name=".HabitsWidget"
            android:label="@string/widget_habits_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>
        <receiver
            android:name=".WorkoutsWidget"
            android:label="@string/widget_workouts_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>
        <receiver
            android:name=".SleepWidget"
            android:label="@string/widget_sleep_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>
        <receiver
            android:name=".FinanceWidget"
            android:label="@string/widget_finance_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>
        <receiver
            android:name=".SummaryWidget"
            android:label="@string/widget_summary_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reminders should land at the time the user chose. Without this the
         plugin falls back to setAndAllowWhileIdle, which Android may defer in
         Doze — a 21:00 nudge arriving much later, which reads as "it never
         fired". Deliberately SCHEDULE_EXACT_ALARM and not USE_EXACT_ALARM:
         the latter is auto-granted but Play restricts it to apps whose core
         purpose is alarms or calendars, which a habit tracker is not. This one
         asks the user, and Settings surfaces that prompt. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
