<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reading bank messages so payments become transactions without being
         typed in. Read-only, and only ever asked for when the user turns the
         feature on: the app is fully usable with this permission refused.

         Note for whoever ships this: Play restricts READ_SMS to apps whose
         core function needs it, and a finance app is on the accepted list but
         must fill in the Permissions Declaration Form. On a directly-installed
         APK it just works. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Noticing a bank message the moment it arrives (SmsReceiver), instead
         of the next time the app is opened. Same permission group as the one
         above, so Android asks once for both. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Sleep and workouts from Health Connect, where the Fitbit app (and
         others) save them. Read only, and only asked for when the person
         connects it in Profile. The Health Connect plugin declares read and
         write for every kind of health data; Play makes an app justify each
         one, so everything Orbit doesn't read is removed here. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_VO" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_VO" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" tools:node="remove" />


    <!-- No backups: see res/xml/data_extraction_rules.xml. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- orbit:// URLs, used by the home-screen shortcuts below to open
                 straight into a logging sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="orbit" />
            </intent-filter>

            <!-- Long-press the app icon: Workout / Sleep / Expense. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- Home-screen widget: today's progress plus one-tap logging. -->
        <receiver
            android:name=".OrbitWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_orbit_info" />
        </receiver>

        <!-- Analytics widgets. One provider each, so every module is its own
             entry in the widget picker and the user can place any combination
             without a configuration screen. They share a layout and a provider
             description; only the picker label differs. -->
        <receiver
            android:name=".HabitsWidget"
            android:label="@string/widget_habits_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>
        <receiver
            android:name=".WorkoutsWidget"
            android:label="@string/widget_workouts_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>
        <receiver
            android:name=".SleepWidget"
            android:label="@string/widget_sleep_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>
        <receiver
            android:name=".FinanceWidget"
            android:label="@string/widget_finance_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>
        <receiver
            android:name=".SummaryWidget"
            android:label="@string/widget_summary_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>

        <!-- Bank messages as they arrive. Exported because the system sends
             the broadcast; guarded by BROADCAST_SMS so only the system can. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reminders should land at the time the user chose. Without this the
         plugin falls back to setAndAllowWhileIdle, which Android may defer in
         Doze — a 21:00 nudge arriving much later, which reads as "it never
         fired". Deliberately SCHEDULE_EXACT_ALARM and not USE_EXACT_ALARM:
         the latter is auto-granted but Play restricts it to apps whose core
         purpose is alarms or calendars, which a habit tracker is not. This one
         asks the user, and Settings surfaces that prompt. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
